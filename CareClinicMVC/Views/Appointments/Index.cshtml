@model IEnumerable<CareClinicMVC.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">📅 Appointments Schedule</h2>
            <p class="text-muted mb-0">Manage clinic consultations, patient visits, and booking statuses</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            + Book New Appointment
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Patient</th>
                            <th>Doctor & Department</th>
                            <th>Date & Time Slot</th>
                            <th>Status</th>
                            <th>Reason for Visit</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <span class="fw-bold text-dark">@(item.Patient?.FullName ?? "Unknown Patient")</span>
                                        <div class="small text-muted">📞 @(item.Patient?.Phone ?? "No Phone")</div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">Dr. @(item.Doctor?.FullName ?? "Unassigned")</span>
                                        <div>
                                            <span class="badge bg-light text-dark border">@(item.Doctor?.Specialization ?? "General")</span>
                                            @if (item.Doctor?.Department != null)
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                    @item.Doctor.Department.Name
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.AppointmentDate.ToString("yyyy-MM-dd")</div>
                                        <span class="badge bg-light text-secondary border">⏰ @item.TimeSlot</span>
                                    </td>
                                    <td>
                                        @{
                                            var statusClass = item.Status switch
                                            {
                                                CareClinicMVC.Models.AppointmentStatus.Scheduled => "bg-primary",
                                                CareClinicMVC.Models.AppointmentStatus.Completed => "bg-success",
                                                CareClinicMVC.Models.AppointmentStatus.Cancelled => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @statusClass">@item.Status</span>
                                    </td>
                                    <td class="text-muted small">
                                        @(item.ReasonForVisit ?? "Routine Checkup")
                                    </td>
                                    <td class="text-center pe-3">
                                        <div class="btn-group btn-group-sm" role="group">
                                            @if (item.Status == CareClinicMVC.Models.AppointmentStatus.Scheduled)
                                            {
                                                <a asp-controller="MedicalRecords" asp-action="Create" asp-route-appointmentId="@item.Id" 
                                                   class="btn btn-success" title="Start Consultation">
                                                    🩺 Consult
                                                </a>
                                                <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                                    <button type="submit" class="btn btn-outline-danger">Cancel</button>
                                                </form>
                                            }
                                            else if (item.Status == CareClinicMVC.Models.AppointmentStatus.Completed && item.MedicalRecord != null)
                                            {
                                                <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@item.MedicalRecord.Id" 
                                                   class="btn btn-outline-primary" title="View Prescription">
                                                    📄 Prescription
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small px-2">Completed</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <h5>No Appointments Scheduled</h5>
                                    <p class="mb-3">Book your first patient consultation now.</p>
                                    <a asp-action="Create" class="btn btn-sm btn-primary">+ Book New Appointment</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
