@model CareClinicMVC.Models.MedicalRecord

@{
    ViewData["Title"] = "Patient Consultation";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-md-11">

@*             {{!-- Patient & Appointment Summary Header --}}
 *@            @if (Model.Appointment != null)
            {
                <div class="card shadow-sm border-0 mb-4 bg-light">
                    <div class="card-body p-4">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <span class="badge bg-primary mb-2">Active Consultation</span>
                                <h4 class="fw-bold mb-1">🧑‍🤝‍🧑 @(Model.Appointment.Patient?.FullName ?? "Patient")</h4>
                                <div class="text-muted small">
                                    <span>📞 @(Model.Appointment.Patient?.Phone ?? "—")</span> | 
                                    <span>Gender: @(Model.Appointment.Patient?.Gender.ToString() ?? "—")</span> |
                                    <span>Blood Group: <strong class="text-danger">@(Model.Appointment.Patient?.BloodGroup ?? "—")</strong></span>
                                </div>
                            </div>
                            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                                <div class="fw-semibold text-dark">👨‍⚕️ Dr. @(Model.Appointment.Doctor?.FullName ?? "Doctor")</div>
                                <div class="text-muted small">@(Model.Appointment.Doctor?.Specialization ?? "Specialist")</div>
                                <div class="badge bg-secondary mt-1">🗓️ @Model.Appointment.AppointmentDate.ToString("yyyy-MM-dd") (@Model.Appointment.TimeSlot)</div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Appointment.ReasonForVisit))
                        {
                            <div class="mt-3 pt-3 border-top">
                                <span class="fw-semibold text-muted small">Chief Complaint / Reason for Visit:</span>
                                <p class="mb-0 text-dark">@Model.Appointment.ReasonForVisit</p>
                            </div>
                        }
                    </div>
                </div>
            }

         @*    {{!-- Medical Record Form --}} *@
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0 fw-bold">🩺 Doctor Consultation & Prescription</h5>
                    <small class="text-white-50">Record diagnosis, prescribe medications, and add clinical notes</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="AppointmentId" />

                        <div class="row g-3">
                            @* {{!-- Diagnosis --}} *@
                            <div class="col-12">
                                <label asp-for="Diagnosis" class="form-label fw-semibold">Diagnosis <span class="text-danger">*</span></label>
                                <input asp-for="Diagnosis" class="form-control form-control-lg" placeholder="e.g. Acute Bacterial Tonsillitis, Type 2 Diabetes..." />
                                <span asp-validation-for="Diagnosis" class="text-danger small"></span>
                            </div>

                            @* {{!-- Prescribed Medications --}} *@
                            <div class="col-12">
                                <label asp-for="PrescribedMedications" class="form-label fw-semibold">
                                    💊 Prescribed Medications (Rx)
                                </label>
                                <textarea asp-for="PrescribedMedications" rows="4" class="form-control font-monospace" 
                                          placeholder="1. Amoxicillin 500mg - 1 capsule 3 times daily for 7 days&#10;2. Paracetamol 500mg - 1 tablet every 6 hours as needed for fever"></textarea>
                                <span asp-validation-for="PrescribedMedications" class="text-danger small"></span>
                                <small class="text-muted">Enter drug names, dosage, frequency, and duration (one per line).</small>
                            </div>

                            @* {{!-- Doctor Notes --}} *@
                            <div class="col-md-8">
                                <label asp-for="DoctorNotes" class="form-label fw-semibold">Doctor's Clinical Notes & Advice</label>
                                <textarea asp-for="DoctorNotes" rows="3" class="form-control" 
                                          placeholder="Patient advised to rest, drink warm fluids, and return if fever persists..."></textarea>
                                <span asp-validation-for="DoctorNotes" class="text-danger small"></span>
                            </div>

                            @* {{!-- Follow-Up Date --}} *@
                            <div class="col-md-4">
                                <label asp-for="FollowUpDate" class="form-label fw-semibold">Follow-Up Visit Date</label>
                                <input asp-for="FollowUpDate" type="date" class="form-control" />
                                <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                                <small class="text-muted">Optional recommended next consultation</small>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success btn-lg px-4">
                                ✅ Complete Consultation & Save
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
