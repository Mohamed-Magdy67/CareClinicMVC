@model IEnumerable<CareClinicMVC.Models.Patient>

@{
    ViewData["Title"] = "Patients";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">🧑‍🤝‍🧑 Patients Registry</h2>
            <p class="text-muted mb-0">View, search, and manage all registered patients</p>
        </div>
        <a asp-action="Create" class="btn btn-success shadow-sm">+ Register New Patient</a>
    </div>

@*     {{!-- Search Bar --}}
 *@    <form method="get" asp-action="Index" class="mb-4">
        <div class="input-group shadow-sm">
            <span class="input-group-text bg-white border-end-0">🔍</span>
            <input type="text"
                   name="searchTerm"
                   value="@ViewBag.CurrentSearch"
                   class="form-control border-start-0 ps-0"
                   placeholder="Search by patient name or phone number..." />
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    @if (ViewBag.CurrentSearch != null)
    {
        <p class="text-muted mb-3">
            Showing results for: <strong class="text-dark">"@ViewBag.CurrentSearch"</strong>
        </p>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Patient Name</th>
                            <th>Phone</th>
                            <th>Gender</th>
                            <th>Blood Group</th>
                            <th>Date of Birth</th>
                            <th>Registered</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <span class="fw-bold text-dark">@item.FullName</span>
                                        @if (item.Email != null)
                                        {
                                            <div class="small text-muted">@item.Email</div>
                                        }
                                    </td>
                                    <td>@item.Phone</td>
                                    <td>
                                        @{
                                            var genderClass = item.Gender.ToString() == "Male" ? "bg-info" : "bg-pink";
                                            var genderIcon = item.Gender.ToString() == "Male" ? "👨" : "👩";
                                        }
                                        <span class="badge bg-secondary">@genderIcon @item.Gender</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger">@item.BloodGroup</span>
                                    </td>
                                    <td>@item.DateOfBirth.ToString("yyyy-MM-dd")</td>
                                    <td class="small text-muted">@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td class="text-center pe-3">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-controller="Appointments" asp-action="Create" asp-route-patientId="@item.Id" class="btn btn-outline-success" title="Book Appointment">📅 Book</a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">Details</a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    @if (ViewBag.CurrentSearch != null)
                                    {
                                        <h5>No patients matched "@ViewBag.CurrentSearch"</h5>
                                        <p>Try a different name or phone number.</p>
                                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Search</a>
                                    }
                                    else
                                    {
                                        <h5>No Patients Registered Yet</h5>
                                        <p class="mb-3">Get started by registering your first patient.</p>
                                        <a asp-action="Create" class="btn btn-sm btn-success">+ Register New Patient</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
