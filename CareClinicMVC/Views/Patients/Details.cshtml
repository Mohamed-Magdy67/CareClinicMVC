@model CareClinicMVC.Models.Patient

@{
    ViewData["Title"] = "Patient Profile";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-md-11">

            @* {{!-- Patient Info Card --}} *@
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0 fw-bold">🧑‍🤝‍🧑 @Model.FullName</h4>
                        <small class="text-white-50">Registered on @Model.CreatedAt.ToString("yyyy-MM-dd")</small>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-light text-dark me-1">@Model.Gender</span>
                        <span class="badge bg-danger">@Model.BloodGroup</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Email Address:</dt>
                        <dd class="col-sm-8 fw-semibold">@(Model.Email ?? "—")</dd>

                        <dt class="col-sm-4 text-muted">Phone Number:</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Phone</dd>

                        <dt class="col-sm-4 text-muted">Date of Birth:</dt>
                        <dd class="col-sm-8">@Model.DateOfBirth.ToString("yyyy-MM-dd")</dd>

                        <dt class="col-sm-4 text-muted">Gender:</dt>
                        <dd class="col-sm-8">@Model.Gender</dd>

                        <dt class="col-sm-4 text-muted">Blood Group:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-danger fs-6">@Model.BloodGroup</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Address:</dt>
                        <dd class="col-sm-8">@(Model.Address ?? "—")</dd>
                    </dl>
                </div>
            </div>

            @* {{!-- Appointment History Card --}} *@
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0 fw-bold">📋 Appointment History</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Appointments != null && Model.Appointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Date & Time Slot</th>
                                        <th>Doctor</th>
                                        <th>Status</th>
                                        <th>Reason for Visit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in Model.Appointments)
                                    {
                                        
                                        <tr>
                                            <td class="ps-3">
                                                <span class="fw-semibold">@app.AppointmentDate.ToString("yyyy-MM-dd")</span>
                                                <div class="small text-muted">@app.TimeSlot</div>
                                            </td>
                                            <td>Dr. @(app.Doctor?.FullName ?? "N/A")</td>
                                            <td>
                                                @{
                                                    var statusClass = app.Status.ToString() switch
                                                    {
                                                        "Scheduled" => "bg-primary",
                                                        "Completed" => "bg-success",
                                                        "Cancelled" => "bg-danger",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @statusClass">@app.Status</span>
                                            </td>
                                            <td class="text-muted small">@(app.ReasonForVisit ?? "—")</td>
                                        </tr>
                                        
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <p class="mb-0">No appointment history for this patient yet.</p>
                        </div>
                    }
                </div>
            </div>

            @* {{!-- Actions --}} *@
            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                <div>
                    <a asp-controller="Appointments" asp-action="Create" asp-route-patientId="@Model?.Id" class="btn btn-success me-2">
                        📅 Book Appointment
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning px-4 text-dark fw-semibold">
                        Edit Patient
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
