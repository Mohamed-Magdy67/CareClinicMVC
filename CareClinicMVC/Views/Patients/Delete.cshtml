@model CareClinicMVC.Models.Patient

@{
    ViewData["Title"] = "Delete Patient";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 fw-bold">⚠️ Delete Patient Confirmation</h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>Warning:</strong> Are you sure you want to permanently delete the record of
                        <strong>@Model.FullName</strong>? This action cannot be undone and will remove all their data.
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Full Name:</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.FullName</dd>

                        <dt class="col-sm-4 text-muted">Phone:</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>

                        <dt class="col-sm-4 text-muted">Gender:</dt>
                        <dd class="col-sm-8">@Model.Gender</dd>

                        <dt class="col-sm-4 text-muted">Blood Group:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-danger">@Model.BloodGroup</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Date of Birth:</dt>
                        <dd class="col-sm-8">@Model.DateOfBirth.ToString("yyyy-MM-dd")</dd>

                        <dt class="col-sm-4 text-muted">Registered:</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
                    </dl>

                    <hr class="my-4" />

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel & Back</a>
                            <button type="submit" class="btn btn-danger px-4">Yes, Delete Patient</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
