@model CareClinicMVC.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Clinic Dashboard";
}

<div class="container mt-4">
    @* {{!-- Top Hero & Date Banner --}} *@
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0 text-dark">🏥 Clinic Operations Dashboard</h2>
            <p class="text-muted mb-0">Overview of patient visits, medical staff, consultations, and revenue</p>
        </div>
        <div class="text-end">
            <span class="badge bg-light text-dark border p-2 fs-6">
                📅 @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
            </span>
        </div>
    </div>

    @* {{!-- 4 KPI Statistics Cards --}} *@
    <div class="row g-3 mb-4">
        @* {{!-- Total Patients --}} *@
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-bold text-uppercase">Total Patients</div>
                            <h2 class="fw-bold text-dark my-1">@Model.TotalPatients</h2>
                            <small class="text-success fw-semibold">🧑‍🤝‍🧑 Registered Profiles</small>
                        </div>
                        <div class="bg-success-subtle text-success p-3 rounded-circle fs-3">
                            👥
                        </div>
                    </div>
                </div>
            </div>
        </div>

       @*  {{!-- Active Doctors --}} *@
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-bold text-uppercase">Active Doctors</div>
                            <h2 class="fw-bold text-dark my-1">@Model.TotalDoctors</h2>
                            <small class="text-primary fw-semibold">👨‍⚕️ Medical Specialists</small>
                        </div>
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3">
                            🩺
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* {{!-- Today's Appointments --}} *@
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-bold text-uppercase">Today's Visits</div>
                            <h2 class="fw-bold text-dark my-1">@Model.TodayAppointmentsCount</h2>
                            <small class="text-warning fw-semibold">🗓️ Total: @Model.TotalAppointments Bookings</small>
                        </div>
                        <div class="bg-warning-subtle text-warning p-3 rounded-circle fs-3">
                            ⏰
                        </div>
                    </div>
                </div>
            </div>
        </div>

       @*  {{!-- Total Revenue --}} *@
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-bold text-uppercase">Total Revenue</div>
                            <h2 class="fw-bold text-success my-1">$@Model.TotalRevenue.ToString("N2")</h2>
                            <small class="text-muted">💰 Completed Consultations</small>
                        </div>
                        <div class="bg-info-subtle text-info p-3 rounded-circle fs-3">
                            💵
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* {{!-- Quick Action Shortcuts Bar --}} *@
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <span class="fw-bold text-muted text-uppercase small">⚡ Quick Actions:</span>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
                        + Book Appointment
                    </a>
                    <a asp-controller="Patients" asp-action="Create" class="btn btn-success btn-sm shadow-sm">
                        + Register Patient
                    </a>
                    <a asp-controller="Doctors" asp-action="Create" class="btn btn-warning text-dark btn-sm shadow-sm">
                        + Add Doctor
                    </a>
                    <a asp-controller="Departments" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        🏥 View Departments
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* {{!-- Recent Appointments Table --}} *@
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">📋 Recent Appointments & Visits</h5>
            <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-outline-light">
                View All Appointments →
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Patient</th>
                            <th>Doctor</th>
                            <th>Date & Time</th>
                            <th>Status</th>
                            <th>Reason</th>
                            <th class="text-center pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentAppointments != null && Model.RecentAppointments.Any())
                        {
                            @foreach (var app in Model.RecentAppointments)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-bold text-dark">@(app.Patient?.FullName ?? "Unknown")</div>
                                        <div class="small text-muted">📞 @(app.Patient?.Phone ?? "—")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">Dr. @(app.Doctor?.FullName ?? "Doctor")</div>
                                        <span class="badge bg-light text-dark border">@(app.Doctor?.Specialization ?? "General")</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@app.AppointmentDate.ToString("yyyy-MM-dd")</div>
                                        <span class="badge bg-light text-secondary border">⏰ @app.TimeSlot</span>
                                    </td>
                                    <td>
                                        @{
                                            var statusClass = app.Status switch
                                            {
                                                CareClinicMVC.Models.AppointmentStatus.Scheduled => "bg-primary",
                                                CareClinicMVC.Models.AppointmentStatus.Completed => "bg-success",
                                                CareClinicMVC.Models.AppointmentStatus.Cancelled => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @statusClass">@app.Status</span>
                                    </td>
                                    <td class="text-muted small">
                                        @(app.ReasonForVisit ?? "Routine Checkup")
                                    </td>
                                    <td class="text-center pe-3">
                                        @if (app.Status == CareClinicMVC.Models.AppointmentStatus.Scheduled)
                                        {
                                            <a asp-controller="MedicalRecords" asp-action="Create" asp-route-appointmentId="@app.Id" 
                                               class="btn btn-sm btn-success">
                                                🩺 Consult
                                            </a>
                                        }
                                        else if (app.Status == CareClinicMVC.Models.AppointmentStatus.Completed && app.MedicalRecord != null)
                                        {
                                            <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@app.MedicalRecord.Id" 
                                               class="btn btn-sm btn-outline-primary">
                                                📄 Rx
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                                                View
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <h5>No Appointments Found</h5>
                                    <p class="mb-3">Get started by scheduling your first patient consultation.</p>
                                    <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary btn-sm">
                                        + Book New Appointment
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
